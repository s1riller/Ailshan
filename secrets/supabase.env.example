# Секреты своего Supabase. Настоящий файл создаёт `scripts/supabase.sh init`
# в /opt/ailshan/secrets/supabase.env — руками его писать не нужно; здесь
# только перечень переменных, которые читает deploy/supabase/compose.yaml.
SUPABASE_PUBLIC_URL=https://supabase.ailshan.jhfasd.space
SITE_URL=https://ailshan.jhfasd.space
POSTGRES_PASSWORD=<hex>
JWT_SECRET=<hex, >= 32 символов>
JWT_EXPIRY=3600
ANON_KEY=<JWT role=anon, подписан JWT_SECRET>
SERVICE_ROLE_KEY=<JWT role=service_role>
DASHBOARD_USERNAME=ailshan
DASHBOARD_PASSWORD=<hex>
PG_META_CRYPTO_KEY=<hex>
KONG_HOST_PORT=54321
POSTGRES_HOST_PORT=54322
DISABLE_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Ailshan
