# Скопируйте в .env рядом с compose.yaml на сервере — compose читает его сам.
# Здесь только несекретные значения; сервисный ключ — в файле AILSHAN_ENV_FILE.
DOMAIN=ailshan.jhfasd.space
# Свой Supabase на этом же сервере (deploy/supabase, scripts/supabase.sh):
# URL и ключ печатает `scripts/supabase.sh keys`
NEXT_PUBLIC_SUPABASE_URL=https://supabase.ailshan.jhfasd.space
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY из scripts/supabase.sh keys>
AILSHAN_ENV_FILE=/opt/ailshan/secrets/ailshan.env
TZ=Europe/Moscow
