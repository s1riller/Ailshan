# Скопируйте в .env рядом с compose.yaml на сервере — compose читает его сам.
# Здесь только несекретные значения; сервисный ключ — в файле AILSHAN_ENV_FILE.
DOMAIN=ailshan.jhfasd.space
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key из Supabase → Settings → API>
AILSHAN_ENV_FILE=/opt/ailshan/secrets/ailshan.env
TZ=Europe/Moscow
